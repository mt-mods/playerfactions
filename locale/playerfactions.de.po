#: init.lua:19
msgid "Allow the use of all playerfactions commands"
msgstr "Erlaubt die Verwendung aller Fraktionsbefehle"

#: init.lua:235 init.lua:366 init.lua:542 mtt.lua:262 mtt.lua:401 mtt.lua:569
msgid "Missing faction name."
msgstr "Fraktionsname fehlt."

#: init.lua:237 init.lua:251 init.lua:461 init.lua:499 mtt.lua:263 mtt.lua:275 mtt.lua:472 mtt.lua:508
msgid "Missing password."
msgstr "Passwort fehlt."

#: init.lua:239 init.lua:364 mtt.lua:266 mtt.lua:399
msgid "You are already in a faction."
msgstr "Du bist bereits in einer Fraktion."

#: init.lua:241 mtt.lua:264
msgid "Faction @1 already exists."
msgstr "Fraktion @1 existiert bereits."

#: init.lua:244 mtt.lua:269
msgid "Registered @1."
msgstr "@1 Registriert."

#: init.lua:257 mtt.lua:294
msgid "You don't own any factions."
msgstr "Du besitzst keine Fraktionen."

#: init.lua:263 init.lua:429 init.lua:473 init.lua:510 mtt.lua:280 mtt.lua:287
msgid "You are the owner of multiple factions, you have to choose one of them: @1."
msgstr "Du bist der Besitzer mehrerer Fraktionen, du musst eine davon auswählen: @1."

#: init.lua:268 init.lua:312 init.lua:368 init.lua:400 init.lua:544 mtt.lua:310 mtt.lua:329 mtt.lua:402 mtt.lua:427 mtt.lua:571
msgid "Faction @1 doesn't exist."
msgstr "Fraktion @1 existiert nicht."

#: init.lua:272 init.lua:436 init.lua:480 init.lua:517 mtt.lua:299 mtt.lua:445 mtt.lua:481 mtt.lua:523
msgid "Permission denied: You are not the owner of that faction, and don't have the @1 privilege."
msgstr "Berechtigung verweigert: Du bist nicht der Besitzer dieser Fraktion und hast nicht das @1-Privileg."

#: init.lua:276 init.lua:372 init.lua:523 mtt.lua:306 mtt.lua:404 mtt.lua:405 mtt.lua:540
msgid "Permission denied: Wrong password."
msgstr "Berechtigung verweigert: Falsches Passwort."

#: init.lua:279 mtt.lua:307 mtt.lua:309
msgid "Disbanded @1."
msgstr "@1 aufgelöst."

#: init.lua:289 mtt.lua:321
msgid "There are no factions yet."
msgstr "Es gibt noch keine Fraktionen."

#: init.lua:291 mtt.lua:317 mtt.lua:318
msgid "Factions (@1): @2."
msgstr "Fraktionen (@1): @2."

#: init.lua:300 mtt.lua:327
msgid "No factions found."
msgstr "Keine Fraktionen gefunden."

#: init.lua:306 init.lua:394 mtt.lua:334 mtt.lua:340 mtt.lua:416 mtt.lua:422
msgid "You are in multiple factions, you have to choose one of them: @1."
msgstr "Du bist in mehreren Fraktionen, du musst eine davon auswählen: @1."

#: init.lua:318
msgid "The faction has more than @1 members, the members list can't be shown."
msgstr "Die Fraktion hat mehr als @1 Mitglieder, die Mitgliederliste kann nicht angezeigt werden."

#: init.lua:324
msgid "Name: @1\nOwner: @2\nMembers: @3"
msgstr "Name: @1"
"Besitzer: @2\n"
"Mitglieder: @3"

#: init.lua:336 init.lua:417 init.lua:497 init.lua:540 mtt.lua:361 mtt.lua:436 mtt.lua:507 mtt.lua:568
msgid "Missing player name."
msgstr "Spielername fehlt."

#: init.lua:340 mtt.lua:362 mtt.lua:366
msgid "Player @1 doesn't exist or isn't in any faction."
msgstr "Spieler @1 existiert nicht oder ist in keiner Fraktion."

#: init.lua:342 mtt.lua:374 mtt.lua:384
msgid "@1 is in the following factions: @2."
msgstr "@1 ist in den folgenden Fraktionen: @2."

#: init.lua:347 mtt.lua:376 mtt.lua:386
msgid "@1 is the owner of the following factions: @2."
msgstr "@1 ist der Besitzer der folgenden Fraktionen: @2."

#: init.lua:349
msgid "@1 doesn't own any factions."
msgstr "@1 besitzt keine Fraktionen."

#: init.lua:354 mtt.lua:388
msgid "@1 has the @2 privilege so they can admin every faction."
msgstr "@1 hat das @2-Privileg, sodass er jede Fraktion verwalten kann."

#: init.lua:370 mtt.lua:403
msgid "You are already in faction @1."
msgstr "Du bist bereits in der Fraktion @1."

#: init.lua:375 mtt.lua:406
msgid "Joined @1."
msgstr "Bist @1 beigetreten."

#: init.lua:377
msgid "Error joining faction."
msgstr "Fehler beim Beitritt zur Fraktion."

#: init.lua:387 mtt.lua:412
msgid "You are not in a faction."
msgstr "Du bist in keiner Fraktion."

#: init.lua:402 mtt.lua:428
msgid "You cannot leave your own faction, change owner or disband it."
msgstr "Du kannst deine eigene Fraktion nicht verlassen, wechsle den Besitzer oder löse die Fraktion auf."

#: init.lua:404 mtt.lua:429
msgid "You aren't part of faction @1."
msgstr "Du bist nicht Teil der Fraktion @1."

#: init.lua:407 mtt.lua:430
msgid "Left @1."
msgstr "Hast @1 verlassen."

#: init.lua:409
msgid "Error leaving faction."
msgstr "Fehler beim Verlassen der Fraktion."

#: init.lua:423 init.lua:467 init.lua:504 mtt.lua:437 mtt.lua:473 mtt.lua:512
msgid "You don't own any factions, you can't use this command."
msgstr "Du besitzst keine Fraktionen, du kannst diesen Befehl nicht verwenden."

#: init.lua:440 mtt.lua:452
msgid "@1 is not in the specified faction."
msgstr "@1 ist nicht in der angegebenen Fraktion."

#: init.lua:444 mtt.lua:458
msgid "You cannot kick the owner of a faction, use '/factions chown <player> <password> [<faction>]' to change the ownership."
msgstr "Du kannst den Besitzer einer Fraktion nicht rauswerfen, verwende „/factions chown <Spieler> <Passwort> [<Fraktion>]“, um den Besitzer zu ändern."

#: init.lua:450 mtt.lua:466
msgid "Kicked @1 from faction."
msgstr "@1 aus Fraktion geworfen."

#: init.lua:453
msgid "Error kicking @1 from faction."
msgstr "Fehler beim Rauswerfen von @1 aus der Fraktion."

#: init.lua:485 mtt.lua:488 mtt.lua:492 mtt.lua:497
msgid "Password has been updated."
msgstr "Passwort wurde aktualisiert."

#: init.lua:487
msgid "Failed to change password."
msgstr "Passwort konnte nicht geändert werden."

#: init.lua:521 mtt.lua:533 mtt.lua:538
msgid "@1 isn't in faction @2."
msgstr "@1 ist nicht in der Fraktion @2."

#: init.lua:526 mtt.lua:541 mtt.lua:544
msgid "Ownership has been transferred to @1."
msgstr "Eigentum wurde auf @1 übertragen."

#: init.lua:528
msgid "Failed to transfer ownership."
msgstr "Eigentum konnte nicht übertragen werden."

#: init.lua:535 mtt.lua:555 mtt.lua:563
msgid "Permission denied: You can't use this command, @1 priv is needed."
msgstr "Berechtigung verweigert: Du kannst diesen Befehl nicht verwenden, @1-Privileg ist erforderlich."

#: init.lua:546 mtt.lua:574
msgid "Player @1 doesn't exist."
msgstr "Spieler @1 existiert nicht."

#: init.lua:550 init.lua:552 mtt.lua:579 mtt.lua:588
msgid "Player @1 is already in faction @2."
msgstr "Spieler @1 ist bereits in der Fraktion @2."

#: init.lua:555 mtt.lua:595
msgid "@1 is now a member of faction @2."
msgstr "@1 ist jetzt Mitglied der Fraktion @2."

#: init.lua:558
msgid "Error adding @1 to @2."
msgstr "Fehler beim Hinzufügen von @1 zu @2"

#: init.lua:570 mtt.lua:256
msgid "Unknown subcommand. Run '/help factions' for help."
msgstr "Unbekannter Unterbefehl. Führe „/help factions“ aus, um Hilfe zu erhalten."

#: init.lua:579
msgid "Create a new faction"
msgstr "Erstelle eine neue Fraktion"

#: init.lua:582
msgid "List available factions"
msgstr "Verfügbare Fraktionen auflisten"

#: init.lua:585
msgid "See information about a faction"
msgstr "Informationen zu einer Fraktion anzeigen"

#: init.lua:588
msgid "See information about a player"
msgstr "Informationen zu einem Spieler anzeigen"

#: init.lua:591
msgid "Join an existing faction"
msgstr "Trete einer bestehenden Fraktion bei"

#: init.lua:594
msgid "Leave your faction"
msgstr "Deine Fraktion verlassen"

#: init.lua:597
msgid "Kick someone from your faction or from the given faction"
msgstr "Jemanden aus deiner Fraktion oder der angegebenen Fraktion werfen"

#: init.lua:600
msgid "Disband your faction or the given faction"
msgstr "Löse deine Fraktion oder die angegebene Fraktion auf"

#: init.lua:603
msgid "Change your faction's password or the password of the given faction"
msgstr "Ändere das Passwort deiner Fraktion oder das Passwort der angegebenen Fraktion"

#: init.lua:606
msgid "Transfer ownership of your faction"
msgstr "Eigentum deiner Fraktion übertragen"

#: init.lua:609
msgid "Add player to a faction, you need @1 priv"
msgstr "Füge einen Spieler zu einer Fraktion hinzu, du benötigst @1-Privilegien"
